NODE_ENV=test
APP_RELEASE=test-suite
PORT=4001
API_PREFIX=api/v1
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017/rich_culture_test?replicaSet=rs0&directConnection=true
MONGO_REQUIRE_REPLICA_SET=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_MAX_POOL_SIZE=5
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TLS=false
QUEUE_PREFIX=rich-culture-test
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_KEY_PREFIX=rich-culture-test-rate-limit
LOG_LEVEL=silent
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=test-metrics-bearer-token-32-characters-minimum
JWT_ACCESS_SECRET=test-access-secret-32-characters-minimum
JWT_REFRESH_SECRET=test-refresh-secret-32-characters-minimum
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_TOKEN_PEPPER=test-token-pepper-32-characters-minimum
CUSTOMER_JWT_ACCESS_SECRET=test-customer-access-secret-32-characters-minimum
CUSTOMER_JWT_REFRESH_SECRET=test-customer-refresh-secret-32-characters-minimum
CUSTOMER_TOKEN_PEPPER=test-customer-token-pepper-32-characters-minimum
CSRF_SECRET=test-csrf-secret-32-characters-minimum
CSRF_TTL_SECONDS=7200
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=
MEDIA_STORAGE_ROOT=/tmp/rich-culture-test-media
MEDIA_MIN_FREE_BYTES=67108864
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_INPUT_PIXELS=40000000
MEDIA_WEBP_QUALITY=82
MEDIA_STAGING_MAX_AGE_SECONDS=3600
RAZORPAY_KEY_ID=rzp_test_phase8example
RAZORPAY_KEY_SECRET=test-razorpay-api-secret-32-characters
RAZORPAY_WEBHOOK_SECRET=test-razorpay-webhook-secret-32-characters
RAZORPAY_CHECKOUT_NAME=Rich Culture Test
RAZORPAY_API_TIMEOUT_MS=5000
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_NAME=Rich Culture Test
EMAIL_FROM_ADDRESS=no-reply@richculture.in
OPERATIONS_ALERT_EMAILS=operations@richculture.in
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_MAX_CONNECTIONS=2

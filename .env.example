NODE_ENV=development
APP_RELEASE=local
PORT=4000
API_PREFIX=api/v1
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

MONGODB_URI=mongodb://127.0.0.1:27017/rich_culture?replicaSet=rs0&directConnection=true
MONGO_REQUIRE_REPLICA_SET=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_MAX_POOL_SIZE=20

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
QUEUE_PREFIX=rich-culture

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_KEY_PREFIX=rich-culture-rate-limit
LOG_LEVEL=debug
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=

JWT_ACCESS_SECRET=dev-only-access-secret-change-me-000000000000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0000000000000000000000
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_TOKEN_PEPPER=dev-only-token-pepper-change-me-00000000000000000000000
CUSTOMER_JWT_ACCESS_SECRET=dev-only-customer-access-secret-change-me-000000000000000000
CUSTOMER_JWT_REFRESH_SECRET=dev-only-customer-refresh-secret-change-me-00000000000000000
CUSTOMER_TOKEN_PEPPER=dev-only-customer-token-pepper-change-me-000000000000000000
CUSTOMER_EMAIL_VERIFICATION_TTL_SECONDS=86400
CUSTOMER_PASSWORD_RESET_TTL_SECONDS=1800
CUSTOMER_AUTH_EMAIL_COOLDOWN_SECONDS=60
CUSTOMER_MOBILE_OTP_TTL_SECONDS=600
CUSTOMER_MOBILE_OTP_COOLDOWN_SECONDS=60
CUSTOMER_MOBILE_OTP_MAX_ATTEMPTS=5
CUSTOMER_RETURN_WINDOW_DAYS=7
EXCHANGE_RESERVATION_TTL_DAYS=14
RETURN_EVIDENCE_MAX_FILES=5
RETURN_EVIDENCE_MAX_UPLOAD_BYTES=5242880
PUBLIC_STOREFRONT_URL=http://localhost:3000
CSRF_SECRET=dev-only-csrf-secret-change-me-000000000000000000000000
CSRF_TTL_SECONDS=7200
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=

# Use an absolute persistent-volume path in production, e.g. /var/lib/rich-culture/media
MEDIA_STORAGE_ROOT=./data/media
MEDIA_MAX_UPLOAD_BYTES=26214400
MEDIA_MAX_INPUT_PIXELS=40000000
MEDIA_WEBP_QUALITY=82
MEDIA_STAGING_MAX_AGE_SECONDS=3600
# Readiness fails below this free-space floor (512 MiB default).
MEDIA_MIN_FREE_BYTES=536870912

# Use Test Mode keys until the complete staging payment flow is verified.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-api-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-independent-webhook-secret
RAZORPAY_CHECKOUT_NAME=Rich Culture
RAZORPAY_API_TIMEOUT_MS=10000

# Development only. Production startup requires EMAIL_DELIVERY_MODE=smtp.
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_NAME=Rich Culture
EMAIL_FROM_ADDRESS=no-reply@richculture.in
OPERATIONS_ALERT_EMAILS=
SMTP_HOST=
SMTP_PORT=587
# Use true for implicit TLS on port 465; port 587 normally uses false plus STARTTLS.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_MAX_CONNECTIONS=5

# Provider-neutral mobile messaging. The HTTP adapter receives a JSON request with an
# Idempotency-Key header. Production cannot use log mode while a mobile channel is enabled.
MESSAGE_DELIVERY_MODE=log
SMS_DELIVERY_ENABLED=true
WHATSAPP_DELIVERY_ENABLED=false
MESSAGE_PROVIDER_URL=
MESSAGE_PROVIDER_TOKEN=
SMS_SENDER=
WHATSAPP_SENDER=
MESSAGE_PROVIDER_TIMEOUT_MS=10000

# Required only by npm run admin:bootstrap
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
